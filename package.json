{
  "name": "approach",
  "author": "Bus driver",
  "version": "1.2.5",
  "keywords": ["pebble-app"],
  "private": true,
  "dependencies": {
    "pebble-clay": "^1.0.4"
  },
  "pebble": {
    "displayName": "Approach",
