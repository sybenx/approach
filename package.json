      "DAY_COLOR_BG", "DAY_COLOR_TIME", "DAY_COLOR_TEXT", "DAY_COLOR_LABEL", "DAY_COLOR_RULE", "DAY_COLOR_BAR", "DAY_COLOR_EMPTY", "DAY_COLOR_HEART", "BOTTOM_ICONS", "DATE_STYLE"
    ],
    "resources": {
      "media": [
        { "type": "bitmap", "name": "IMAGE_MENU_ICON", "file": "images/menu_icon.png", "menuIcon": true },

