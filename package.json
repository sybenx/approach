        { "type": "font", "name": "FONT_XB_22", "file": "fonts/Archivo-ExtraBold.ttf", "compatibility": "2.7", "characterRegex": "[0-9A-Z°%-]",   "targetPlatforms": ["emery"] },
        { "type": "font", "name": "FONT_XB_17", "file": "fonts/Archivo-ExtraBold.ttf", "compatibility": "2.7", "characterRegex": "[0-9A-Z°%-]",   "targetPlatforms": ["emery"] },
        { "type": "font", "name": "FONT_XB_15", "file": "fonts/Archivo-ExtraBold.ttf", "compatibility": "2.7", "characterRegex": "[0-9A-Z°%-]",   "targetPlatforms": ["emery"] },

        { "type": "font", "name": "FONT_XB_40", "file": "fonts/Archivo-ExtraBold.ttf", "compatibility": "2.7", "characterRegex": "[0-9:]",        "targetPlatforms": ["aplite", "basalt", "diorite"] },
        { "type": "font", "name": "FONT_XB_16", "file": "fonts/Archivo-ExtraBold.ttf", "compatibility": "2.7", "characterRegex": "[0-9A-Z°%-]",   "targetPlatforms": ["aplite", "basalt", "diorite"] },
        { "type": "font", "name": "FONT_XB_12", "file": "fonts/Archivo-ExtraBold.ttf", "compatibility": "2.7", "characterRegex": "[0-9A-Z°%-]",   "targetPlatforms": ["aplite", "basalt", "diorite"] }
